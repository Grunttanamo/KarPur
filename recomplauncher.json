{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "name": "KarPur",
    "repo": "Grunttanamo/KarPur",
    "game": {
        "kind": "iso",
        "label": "Your own Pokemon Scarlet or Pokemon Violet base game as an .xci cartridge dump, from your own console. KarPur also asks for update 4.0.0 as an .nsp and for prod.keys, in its Setup tab."
    },
    "inputs": [
        {
            "id": "update",
            "label": "Update 4.0.0 (.nsp)",
            "role": "update",
            "formats": [
                {
                    "type": "file",
                    "extensions": [
                        "nsp"
                    ]
                }
            ]
        },
        {
            "id": "keys",
            "label": "prod.keys from your own console",
            "role": "key",
            "shared": "switch.prod-keys"
        }
    ],
    "start": {
        "program": [
            "KarPur/build/game/karpur.exe"
        ]
    },
    "prepare": {
        "program": [
            "KarPur-Launcher.exe"
        ],
        "args": [
            "--prepare",
            "--game",
            "{game}",
            "--update",
            "{input:update}",
            "--keys",
            "{input:keys}",
            "--target",
            "{install}"
        ],
        "label": "Building KarPur from your game files (30-60 minutes)",
        "timeout": 10800
    }
}
