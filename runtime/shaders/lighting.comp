// Experimental screen-space contact occlusion and one-bounce light approximation.
// Runs on the tone-mapped scene before its HUD. No game-owned image is enlarged.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D scene_depth;
layout(set = 0, binding = 1) uniform sampler2D scene_color;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D result_color;
layout(push_constant) uniform P {
    vec4 projection; // p22, p23, p32, clip depth -w..w
    vec4 controls;   // width, height, AO level, indirect-light level
} p;

float view_distance(float depth) {
    float ndc = p.projection.w > 0.5 ? depth * 2.0 - 1.0 : depth;
    float divisor = ndc * p.projection.z - p.projection.x;
    return abs(divisor) > 1e-6 ? abs(p.projection.y / divisor) : 1e8;
}

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(p.controls.xy);
    if (any(greaterThanEqual(xy, size))) return;
    vec4 color = texelFetch(scene_color, xy, 0);
    float center = view_distance(texelFetch(scene_depth, xy, 0).r);
    if (center > 5000.0 || center < 0.01) { imageStore(result_color, xy, color); return; }

    const vec2 directions[12] = vec2[12](
        vec2(1,0), vec2(0,1), vec2(-1,0), vec2(0,-1),
        vec2(.707,.707), vec2(-.707,.707), vec2(-.707,-.707), vec2(.707,-.707),
        vec2(.924,.383), vec2(-.383,.924), vec2(-.924,-.383), vec2(.383,-.924));
    int samples = int(max(p.controls.z, p.controls.w)) == 1 ? 4 :
                  int(max(p.controls.z, p.controls.w)) == 2 ? 8 : 12;
    float occlusion = 0.0;
    vec3 bounce = vec3(0.0);
    // Keep samples close to the object edge. The old 24-pixel reach made contact effects appear detached.
    float level = max(p.controls.z, p.controls.w);
    float radius = clamp((1.0 + level) * 8.0 / sqrt(max(center, 1.0)), 1.0,
                         level < 1.5 ? 3.0 : level < 2.5 ? 5.0 : 7.0);
    for (int i = 0; i < samples; ++i) {
        ivec2 other = clamp(xy + ivec2(round(directions[i] * radius)), ivec2(0), size - 1);
        float nearby = view_distance(texelFetch(scene_depth, other, 0).r);
        float delta = center - nearby;
        float reach = max(0.12, center * 0.08);
        if (p.controls.z > 0.5)
            occlusion += smoothstep(0.02 * center, reach, delta) *
                         (1.0 - smoothstep(reach, 2.0 * reach, delta));
        if (p.controls.w > 0.5 && abs(delta) < reach) {
            vec3 neighbor = texelFetch(scene_color, other, 0).rgb;
            bounce += max(neighbor - color.rgb, vec3(0.0));
        }
    }
    float ao = 1.0 - (p.controls.z > 0.5 ? min(occlusion / float(samples), 0.65) *
                     (p.controls.z == 1.0 ? 0.45 : p.controls.z == 2.0 ? 0.75 : 1.10) : 0.0);
    float gi = p.controls.w == 1.0 ? 0.10 : p.controls.w == 2.0 ? 0.20 : 0.32;
    color.rgb = clamp(color.rgb * ao + bounce * (gi / float(samples)), 0.0, 1.0);
    imageStore(result_color, xy, color);
}
