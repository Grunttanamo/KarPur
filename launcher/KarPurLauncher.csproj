<Project Sdk="Microsoft.NET.Sdk">
  <!-- The KarPur launcher: asks for the player's own dumps and keys, builds the game in a folder of their choice with
       tools/setup_build.py and starts it. Built by tools/make_launcher.py, which also writes payload.zip (the
       repository's files plus the prebuilt shader translator and hactool; nothing from the game). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KarPur-Launcher</AssemblyName>
    <RootNamespace>KarPurLauncher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.3.6</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WFO1000: designer serialization of control properties; the launcher builds its controls in code -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="pins.json" LogicalName="pins.json" />
    <!-- Edition artwork supplied by the maintainer for the launcher. -->
    <EmbeddedResource Include="assets/banner-violet.jpg" LogicalName="banner-violet.jpg" />
    <EmbeddedResource Include="assets/banner-scarlet.jpg" LogicalName="banner-scarlet.jpg" />
    <EmbeddedResource Include="assets/*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != ''" />
  </ItemGroup>
</Project>
